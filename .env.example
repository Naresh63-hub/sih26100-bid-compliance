# BIDGUARD AI — Environment Configuration

# -------------------------------------------------------------
# 1. Supabase Backend Services
# -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-do-not-expose

# -------------------------------------------------------------
# 2. FastAPI REST Backend Configuration
# -------------------------------------------------------------
DATABASE_URL=sqlite:///./backend/work/bidguard.db
# For Supabase PostgreSQL direct connection:
# DATABASE_URL=postgresql://postgres.yourproject:yourpassword@aws-0-region.pooler.supabase.com:6543/postgres

API_KEY=your-internal-service-secret
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# -------------------------------------------------------------
# 3. AI / LLM Provider (Optional / Provider Agnostic)
# -------------------------------------------------------------
LLM_URL=
LLM_API_KEY=
LLM_MODEL=
EXTRACTION_CONFIDENCE_THRESHOLD=0.8

# -------------------------------------------------------------
# 4. Storage & Processing Constraints
# -------------------------------------------------------------
MAX_FILE_BYTES=10485760 # 10 MB
MAX_PAGES=100
STORAGE_DIR=backend/work/documents
